import kotlin.String;
import kotlin.collections.List;

CREATE TABLE movie (
    movieId INTEGER NOT NULL PRIMARY KEY,
    title TEXT,
    posterFileName TEXT,
    synopsis TEXT,
    releaseDate TEXT,
    genres TEXT, -- Stocké en JSON
    localCoverFilePath TEXT,
    isFavorite INTEGER DEFAULT 0,
    isSeen INTEGER DEFAULT 0,
    popularity REAL DEFAULT 0.0,
    status TEXT,
    videoKey TEXT,
    duration INTEGER,
    note REAL
);

CREATE TABLE genre (
    genreId INTEGER NOT NULL PRIMARY KEY,
    name TEXT
);

CREATE TABLE actor (
    actorId INTEGER NOT NULL PRIMARY KEY,
    name TEXT,
    role TEXT
);

CREATE TABLE movie_actor_cross_ref (
    movieId INTEGER NOT NULL,
    actorId INTEGER NOT NULL,
    FOREIGN KEY(movieId) REFERENCES movie(movieId) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES actor(actorId) ON DELETE CASCADE,
    PRIMARY KEY(movieId, actorId)
);

CREATE TABLE user_profile (
    uid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    pseudo TEXT NOT NULL,
    avatar_url TEXT,
    bio TEXT,
    interests_json TEXT AS List<String> NOT NULL,
    liked_count INTEGER NOT NULL,
    circle_count INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE social_circle_member (
    uid TEXT NOT NULL,
    member_uid TEXT NOT NULL,
    member_name TEXT,
    member_pseudo TEXT,
    member_avatar_url TEXT,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (uid, member_uid),
    FOREIGN KEY (uid) REFERENCES user_profile(uid) ON DELETE CASCADE
);

 -- QUERIES --

 insertMovie:
 INSERT INTO movie (
     movieId, title, posterFileName, synopsis, releaseDate, genres, localCoverFilePath,
     isFavorite, isSeen, popularity, status, videoKey, duration, note
 ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

 updateExistingMovie:
 UPDATE movie
 SET title = ?, posterFileName = ?, synopsis = ?, releaseDate = ?, genres = ?,
     localCoverFilePath = ?, isFavorite = ?, isSeen = ?, popularity = ?,
     status = ?, videoKey = ?, duration = ?, note = ?
 WHERE movieId = ?;

insertActor:
INSERT INTO actor (actorId, name, role)
VALUES (?, ?, ?);

updateExistingActor:
UPDATE actor SET
    name = ?,
    role = ?
WHERE actorId = ?;

updateMovieWithCover:
UPDATE movie SET
    localCoverFilePath = :localCoverFilePath,
    posterFileName = :remotePosterFileName
WHERE movieId = :movieId;

updateMovieWithFavoriteValue:
UPDATE movie SET
    isFavorite = :isFavorite
WHERE movieId = :movieId;

updateMovieWithVideoKey:
UPDATE movie SET
    videoKey = :videoKey
WHERE movieId = :movieId;

updateMovieWithDetail:
UPDATE movie SET
    releaseDate = :releaseDate,
    synopsis = :overview,
    status = :status,
    popularity = :popularity,
    genres = :genres,
    duration = :duration
WHERE movieId = :movieId;

observeMovies:
SELECT * FROM movie;

observeDetailMovie:
SELECT m.movieId, m.title, m.genres, m.popularity, m.releaseDate, m.synopsis,
       m.status, m.localCoverFilePath, m.videoKey, m.duration, m.posterFileName,
       a.actorId, a.name AS actorName, a.role AS actorRole
FROM movie m
LEFT JOIN movie_actor_cross_ref c ON m.movieId = c.movieId
LEFT JOIN actor a ON c.actorId = a.actorId
WHERE m.movieId = ?;

observeMoviesFavoriteCount:
SELECT COUNT(*)
FROM movie
WHERE isFavorite = 1;

insertMovieActorCrossRef:
INSERT INTO movie_actor_cross_ref (movieId, actorId)
VALUES (?, ?);

deleteMovieActorCrossRefsByMovie:
DELETE FROM movie_actor_cross_ref WHERE movieId = ?;

getMovieById:
SELECT *
FROM movie
WHERE movieId = :movieId;

getActorById:
SELECT *
FROM actor
WHERE actorId = :actorId;

isMovieSynopsisAvailable:
SELECT synopsis IS NOT NULL AND TRIM(synopsis) != '' AS hasSynopsis
FROM movie
WHERE movieId = :movieId;

getFavoriteIds:
SELECT movieId
FROM movie
WHERE isFavorite = 1;

selectUserById:
SELECT *
FROM user_profile
WHERE uid = ?;

selectUserByPseudo:
SELECT *
FROM user_profile
WHERE pseudo = ?;

selectUserProfileWIthMembersById:
SELECT
up.uid AS uid,
up.name AS name,
up.pseudo AS pseudo,
up.avatar_url AS avatar_url,
up.bio AS bio,
up.interests_json AS interests_json,
up.liked_count AS liked_count,
up.circle_count AS circle_count,
scm.member_uid AS member_uid,
scm.member_name AS member_name,
scm.member_pseudo AS member_pseudo,
scm.member_avatar_url AS member_avatar_url,
scm.added_at AS member_added_at
FROM user_profile up
LEFT JOIN social_circle_member scm
ON scm.uid = up.uid
WHERE up.uid = ?;

insertUserProfile:
INSERT INTO user_profile(
uid, name, pseudo, avatar_url, bio, interests_json, liked_count, circle_count, updated_at
) VALUES (?, ?, ?,?, ?, ?, ?, ?, ?);

updateUserProfile:
UPDATE user_profile SET
    name = :name,
    avatar_url = :avatar_url,
    pseudo = :pseudo,
    bio = :bio,
    interests_json = :interests_json,
    liked_count = :liked_count,
    circle_count = :circle_count,
    updated_at = :updated_at
WHERE uid = :uid;

deleteUserProfileById:
DELETE FROM user_profile WHERE uid = ?;

insertSocialMember:
INSERT INTO social_circle_member (uid, member_uid, member_name, member_pseudo, member_avatar_url, added_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteSocialMember:
DELETE FROM social_circle_member WHERE uid = ? AND member_uid = ?;

selectSocialMembersByUid:
SELECT * FROM social_circle_member WHERE uid = ?;

CREATE INDEX IF NOT EXISTS movie_is_favorite ON movie(isFavorite);
CREATE INDEX IF NOT EXISTS idx_user_profile_uid ON user_profile(uid);
CREATE INDEX IF NOT EXISTS idx_user_profile_pseudo ON user_profile(pseudo);
CREATE INDEX IF NOT EXISTS idx_social_circle_member_uid ON social_circle_member(uid);
CREATE INDEX IF NOT EXISTS idx_social_circle_member_composite ON social_circle_member(uid, member_uid);
CREATE INDEX IF NOT EXISTS idx_movie_id ON movie(movieId);
