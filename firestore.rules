rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isRecipient(invite) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.information.pseudo == invite.toPseudo;
    }

    // A declined invite can only be sent again 30 days after the decline (invites declined by old app versions have no declinedAt)
    function cooldownOver(invite) {
      return invite.status != 'DECLINED'
        || !('declinedAt' in invite)
        || request.time.toMillis() > invite.declinedAt + 2592000000;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      match /circle/{memberUid} {
        allow read: if signedIn();
        allow write: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == memberUid);
      }
    }

    match /pseudos/{pseudoLowercase} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pseudo.lower() == pseudoLowercase;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /socialInvites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid == request.auth.uid
          && cooldownOver(resource.data))
        || (isRecipient(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedAt']))
      );
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || isRecipient(resource.data));
    }
  }
}
